{
  "name": "stiq-client",
  "version": "0.0.1",
  "private": true,
  "description": "Encrypted, anonymous, append-only community client (Nostr over Tor).",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location node_modules/.cache/eslint/",
    "test": "jest",
    "verify-deps": "node scripts/check-noble-hashes.js",
    "postinstall": "patch-package && node scripts/check-noble-hashes.js --warn"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.5",
    "@noble/hashes": "^1.8.0",
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^11.2.7",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "node-html-parser": "^6.1.13",
    "nostr-tools": "^2.10.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-camera-kit": "^18.0.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-reanimated": "^3.16.7",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "^14.0.1"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
