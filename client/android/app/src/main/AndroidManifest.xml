<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect default-network changes (Wi-Fi↔cellular) to reconnect Tor promptly -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- TorService foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: foreground service type companion permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+: runtime permission to show the TorService foreground notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Doze/battery-optimization exemption (Tor stability workstream): lets StiqPowerModule prompt
         the user to whitelist the app so the OS does not suspend the dormant Tor daemon in deep sleep.
         Not auto-granted; the app requests it via ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Event reminders (events/reminders.ts): exact AlarmManager triggers so a "2 hours before"
         reminder fires at the minute, not whenever Doze deigns. USE_EXACT_ALARM is auto-granted
         for calendar/alarm functionality on API 33+ (this build is sideloaded, not Play-reviewed);
         SCHEDULE_EXACT_ALARM covers API 31/32 where it is granted by default. If either is absent
         or revoked, AlarmManager silently downgrades to inexact delivery — reminders still fire. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Voice messages (NIP-A0): record audio for inline voice notes -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- QR code scanner: read join codes from camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- In-app updater (T9): PackageInstaller session install of a Tor-downloaded, signer-verified
         APK. The OS still shows its own install-confirm UI and the user must grant "install unknown
         apps" the first time (canRequestPackageInstalls). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+): so the external hand-off can detect Tor Browser
         (isAppInstalled) and open a link in it (ACTION_VIEW + setPackage), and resolve a default
         browser for the fallback. Without this, other packages are invisible and the hand-off fails. -->
    <queries>
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.torbrowser_alpha" />
        <package android:name="org.torproject.android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/LaunchTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Deep-link handler:
             - stiq://join?c=<join-code> : an organizer's invite QR/link; prefills the onboarding
               code field and jumps to the code step (App.tsx handleDeepLink → OnboardingScreen).
             `join` is the ONLY accepted host. The legacy `stiq://cred-resp` manual-exchange link
             was removed: the credential response now travels inside the automatic Tor exchange, so
             it had no handler in handleDeepLink and was simply dead, BROWSABLE attack surface. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="stiq" android:host="join" />
            <!-- stiq://channel/<id> : a space invite link. handleDeepLink routes the `channel`
                 host to acceptInviteLink (in-app join). Without this an externally-tapped invite
                 link (QR, browser, another app) never reached the app. -->
            <data android:scheme="stiq" android:host="channel" />
        </intent-filter>
      </activity>
      <!-- TorService from tor-android: bundled Tor daemon.
           foregroundServiceType required on Android 14+ (API 34).
           android:process=":tor" runs the daemon in its OWN process. tor-android calls
           tor_run_main() IN-PROCESS; when tor aborts (SIGABRT — e.g. the hs_circuitmap/pubsub_install
           assertion tripped by re-entering tor_run_main before the previous run's globals are freed)
           that abort used to kill the WHOLE app (Samsung "app has a bug" dialog). Isolating TorService
           into :tor means such an abort only kills that process — the main process (and the JS/UI
           layer) survives and the reconnect cascade (TorManager/App.tsx) sees the daemon go away and
           starts a FRESH :tor process, which also has fresh globals and so cannot re-trip the same
           assert. StiqTorModule.kt talks to this process ONLY via the filesystem-based Tor control
           socket (a Unix domain socket under app-private storage, shared across all processes of this
           app) and real (non-Local) broadcasts — never a LocalBinder cast, which would break
           cross-process. IPtProxy's pluggable-transport SOCKS listener stays in the main process;
           127.0.0.1 sockets are not process-scoped on Android, so tor in :tor still reaches it. -->
      <!-- StiqTorService (W2 change 4) subclasses org.torproject.jni.TorService purely to promote the
           daemon to a FOREGROUND service with a NEUTRAL IMPORTANCE_MIN notification (no "Tor" wording)
           and to let it survive backgrounding. The bundled AAR's TorService ships no res/ and never
           calls startForeground, so a resource/notification override is impossible — subclassing is
           the sanctioned fallback. Still runs in the :tor process (isolates the tor_run_main abort),
           still not exported, still stopWithTask=false + dataSync FGS type (preserved from Phase A). -->
      <service
        android:name=".StiqTorService"
        android:exported="false"
        android:process=":tor"
        android:stopWithTask="false"
        android:foregroundServiceType="dataSync" />
      <!-- Headless JS service for WorkManager background sync (PLAN.md Obj. 4).
           Not exported — only SyncWorker (same process) or the UnifiedPush receiver (T1, same
           process) starts it. foregroundServiceType=dataSync so StiqUnifiedPushReceiver.onMessage can
           start it via startForegroundService from a background/killed state on API 34+. -->
      <service
        android:name=".StiqSyncService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
      <!-- UnifiedPush distributor → app broadcasts (T1). EXPORTED is required so the distributor (a
           separate app, e.g. ntfy) can deliver NEW_ENDPOINT and the content-free MESSAGE wake. The
           wake carries ZERO content: onMessage just starts StiqSyncService, which derives any
           title-only notification locally over Tor. -->
      <receiver
        android:name=".StiqUnifiedPushReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
            <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
