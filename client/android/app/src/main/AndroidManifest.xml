<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect default-network changes (Wi-Fi↔cellular) to reconnect Tor promptly -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- StiqSyncService foreground service (background sync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: foreground service type companion permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+: runtime permission to show the StiqSyncService foreground notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held briefly by StiqSyncService.handleFgsTimeout so the headless sync task can finish its
         unwind — in particular the Arti disconnect — after the Android 15 dataSync FGS timeout
         strips our foreground status. React Native's HeadlessJsTaskService already relies on this
         permission (acquireWakeLockNow) and it merges in from a library manifest, but our own use
         must not depend on someone else's dependency continuing to declare it. Normal protection
         level: granted at install, no user prompt. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Anti-tapjacking: lets MainActivity call Window.setHideOverlayWindows(true) (API 31+), which
         hides OTHER apps' TYPE_APPLICATION_OVERLAY windows while ours is visible. Normal protection
         level; it only ever restricts what other apps may draw over us. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Doze/battery-optimization exemption (Tor stability workstream): lets StiqPowerModule prompt
         the user to whitelist the app so the OS does not suspend the dormant Tor daemon in deep sleep.
         Not auto-granted; the app requests it via ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Event reminders (events/reminders.ts): exact AlarmManager triggers so a "2 hours before"
         reminder fires at the minute, not whenever Doze deigns. USE_EXACT_ALARM is auto-granted
         for calendar/alarm functionality on API 33+ (this build is sideloaded, not Play-reviewed);
         SCHEDULE_EXACT_ALARM covers API 31/32 where it is granted by default. If either is absent
         or revoked, AlarmManager silently downgrades to inexact delivery — reminders still fire. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Voice messages (NIP-A0): record audio for inline voice notes -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- QR code scanner: read join codes from camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- In-app updater (T9): PackageInstaller session install of a Tor-downloaded, signer-verified
         APK. The OS still shows its own install-confirm UI and the user must grant "install unknown
         apps" the first time (canRequestPackageInstalls). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+): so the external hand-off can detect Tor Browser
         (isAppInstalled) and open a link in it (ACTION_VIEW + setPackage), and resolve a default
         browser for the fallback. Without this, other packages are invisible and the hand-off fails. -->
    <queries>
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.torbrowser_alpha" />
        <package android:name="org.torproject.android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/LaunchTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Deep-link handler:
             - stiq://join?c=<join-code> : an organizer's invite QR/link; prefills the onboarding
               code field and jumps to the code step (App.tsx handleDeepLink → OnboardingScreen).
             `join` is the ONLY accepted host. The legacy `stiq://cred-resp` manual-exchange link
             was removed: the credential response now travels inside the automatic Tor exchange, so
             it had no handler in handleDeepLink and was simply dead, BROWSABLE attack surface. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="stiq" android:host="join" />
            <!-- stiq://channel/<id> : a space invite link. handleDeepLink routes the `channel`
                 host to acceptInviteLink (in-app join). Without this an externally-tapped invite
                 link (QR, browser, another app) never reached the app. -->
            <data android:scheme="stiq" android:host="channel" />
        </intent-filter>
      </activity>
      <!-- Headless JS service for WorkManager background sync (PLAN.md Obj. 4).
           Not exported — only SyncWorker (same process) or the UnifiedPush receiver (T1, same
           process) starts it. foregroundServiceType=dataSync so StiqUnifiedPushReceiver.onMessage can
           start it via startForegroundService from a background/killed state on API 34+.

           dataSync is still the correct type after re-checking it against the Android 15 timeout
           (step 2 of the TOR-NATIVE-1 checklist in android/build.gradle). The alternatives are
           worse: shortService caps a run at ~3 minutes (below our 90s task plus Tor bootstrap
           headroom, with no margin), mediaProcessing carries the identical 6h/24h budget and does
           not describe what this does, and specialUse — which has no timeout — would be a
           deliberate misdeclaration for what is genuinely a data sync. Budget headroom is ample
           regardless: each run is bounded at 90s by HeadlessJsTaskConfig, so even a maximally
           chatty device at the ~15-minute periodic floor spends ~2.4h of the 6h window. The
           residual risk is push-wake volume stacking on top of that, and StiqSyncService.onTimeout
           now handles the exhausted case gracefully. -->
      <service
        android:name=".StiqSyncService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
      <!-- UnifiedPush distributor → app broadcasts (T1). EXPORTED is required so the distributor (a
           separate app, e.g. ntfy) can deliver NEW_ENDPOINT and the content-free MESSAGE wake. The
           wake carries ZERO content: onMessage just starts StiqSyncService, which derives any
           title-only notification locally over Tor. -->
      <receiver
        android:name=".StiqUnifiedPushReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="org.unifiedpush.android.connector.MESSAGE" />
            <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
            <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
